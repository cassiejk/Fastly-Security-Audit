#!/usr/bin/env bash
set -euo pipefail

_ngwaf_update_source="${BASH_SOURCE[0]}"
while [[ -h "$_ngwaf_update_source" ]]; do
  _ngwaf_update_dir="$(cd -P "$(dirname "$_ngwaf_update_source")" >/dev/null 2>&1 && pwd)"
  _ngwaf_update_source="$(readlink "$_ngwaf_update_source")"
  [[ "$_ngwaf_update_source" == /* ]] ||
    _ngwaf_update_source="$_ngwaf_update_dir/$_ngwaf_update_source"
done
NGWAF_UPDATE_ROOT="$(cd -P "$(dirname "$_ngwaf_update_source")" >/dev/null 2>&1 && pwd)"
unset _ngwaf_update_source _ngwaf_update_dir

[[ -r "$NGWAF_UPDATE_ROOT/lib/runtime.sh" ]] || {
  printf 'ngwaf-update: missing module: %s\n' \
    "$NGWAF_UPDATE_ROOT/lib/runtime.sh" >&2
  exit 1
}
# shellcheck source=lib/runtime.sh
source "$NGWAF_UPDATE_ROOT/lib/runtime.sh"
ngwaf_require_bash_runtime ngwaf-update

BIN_DIR="${FASTLY_AUDIT_BIN_DIR:-$HOME/bin}"
PRIMARY_TARGET="$BIN_DIR/fastly-audit"
LEGACY_TARGET="$BIN_DIR/ngwaf"
UPDATER_TARGET="$BIN_DIR/ngwaf-update"
SHORT_TARGET="$BIN_DIR/fa"
INSTALL_ROOT="${FASTLY_AUDIT_INSTALL_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/fastly-audit}"

candidate="${1:-.}"

# Preserve the legacy workflow: `ngwaf-update ./ngwaf` infers the package root
# from the compatibility entry point. A directory or fastly-audit executable
# may also be supplied directly.
if [[ -d "$candidate" ]]; then
  SOURCE_ROOT="$(cd "$candidate" && pwd -P)"
elif [[ -f "$candidate" ]]; then
  SOURCE_ROOT="$(cd "$(dirname "$candidate")" && pwd -P)"
else
  printf 'ngwaf-update: not found: %s\n' "$candidate" >&2
  exit 1
fi

[[ -f "$SOURCE_ROOT/fastly-audit" \
  && -f "$SOURCE_ROOT/ngwaf" \
  && -f "$SOURCE_ROOT/lib/runtime.sh" \
  && -d "$SOURCE_ROOT/lib" \
  && -d "$SOURCE_ROOT/customer" ]] || {
  printf 'ngwaf-update: %s is not a modular fastly-audit package\n' \
    "$SOURCE_ROOT" >&2
  exit 1
}

# Validate every Bash source before touching the current installation.
while IFS= read -r file; do
  "$BASH" -n "$file"
done < <(
  find "$SOURCE_ROOT" -type f \
    \( \
      -name 'fastly-audit' \
      -o -name 'ngwaf' \
      -o -name 'ngwaf-update' \
      -o -name '*.sh' \
    \) \
    -print |
  sort
)

stage="$(mktemp -d "${TMPDIR:-/tmp}/fastly-audit-install.XXXXXX")"

cleanup_stage() {
  rm -rf "$stage"
}

trap cleanup_stage EXIT

mkdir -p "$stage/lib" "$stage/customer"

install -m 755 "$SOURCE_ROOT/fastly-audit" "$stage/fastly-audit"

install -m 755 "$SOURCE_ROOT/ngwaf" "$stage/ngwaf"

install -m 755 "$SOURCE_ROOT/ngwaf-update" "$stage/ngwaf-update"

cp -R "$SOURCE_ROOT/lib/." "$stage/lib/"
cp -R "$SOURCE_ROOT/customer/." "$stage/customer/"

mkdir -p "$(dirname "$INSTALL_ROOT")" "$BIN_DIR"
if [[ -e "$INSTALL_ROOT" && ! -d "$INSTALL_ROOT" ]]; then
  printf 'ngwaf-update: installation path is not a directory: %s\n' "$INSTALL_ROOT" >&2
  exit 1
fi

# Never replace another program named fa. Existing links from this installer
# are safe to refresh; a regular file or unrelated link needs user attention.
if [[ -e "$SHORT_TARGET" || -L "$SHORT_TARGET" ]]; then
  if [[ ! -L "$SHORT_TARGET" || "$(readlink "$SHORT_TARGET")" != "$INSTALL_ROOT/fastly-audit" ]]; then
    printf 'ngwaf-update: %s already exists and is not this installation; choose another bin directory or resolve the conflict\n' \
      "$SHORT_TARGET" >&2
    exit 1
  fi
fi

declare -a link_targets=("$PRIMARY_TARGET" "$LEGACY_TARGET" "$UPDATER_TARGET" "$SHORT_TARGET")
declare -a link_sources=("$INSTALL_ROOT/fastly-audit" "$INSTALL_ROOT/ngwaf" "$INSTALL_ROOT/ngwaf-update" "$INSTALL_ROOT/fastly-audit")
declare -a link_backups=('' '' '' '')
declare -a link_created=(false false false false)
package_backup=''
transaction_active=false

finish_install() {
  local status=$?
  local i
  if [[ "$transaction_active" == true ]]; then
    for (( i=${#link_targets[@]}-1; i>=0; i-- )); do
      if [[ -n "${link_backups[i]}" ]]; then
        rm -f "${link_targets[i]}"
        mv "${link_backups[i]}" "${link_targets[i]}" || true
      elif [[ "${link_created[i]}" == true ]]; then
        rm -f "${link_targets[i]}"
      fi
    done
    rm -rf "$INSTALL_ROOT"
    if [[ -n "$package_backup" ]]; then
      mv "$package_backup" "$INSTALL_ROOT" || true
    fi
    if [[ -n "$package_backup" ]]; then
      printf 'ngwaf-update: installation failed; previous installation restored\n' >&2
    else
      printf 'ngwaf-update: installation failed; incomplete installation removed\n' >&2
    fi
  fi
  rm -rf "$stage"
  exit "$status"
}
trap finish_install EXIT

if [[ -d "$INSTALL_ROOT" ]]; then
  package_backup="${INSTALL_ROOT}.backup-$(date +%Y%m%d-%H%M%S)-$$"
  mv "$INSTALL_ROOT" "$package_backup"
  printf 'Backup: %s\n' "$package_backup"
fi

transaction_active=true
mv "$stage" "$INSTALL_ROOT"
for (( i=0; i<${#link_targets[@]}; i++ )); do
  if [[ -e "${link_targets[i]}" || -L "${link_targets[i]}" ]]; then
    prior_link="${link_targets[i]}.backup-$(date +%Y%m%d-%H%M%S)-$$"
    mv "${link_targets[i]}" "$prior_link"
    link_backups[i]="$prior_link"
  fi
  ln -s "${link_sources[i]}" "${link_targets[i]}"
  link_created[i]=true
done

"$PRIMARY_TARGET" version
"$LEGACY_TARGET" version
"$SHORT_TARGET" version
transaction_active=false
for (( i=0; i<${#link_targets[@]}; i++ )); do
  if [[ -n "${link_backups[i]}" ]]; then
    if [[ -L "${link_backups[i]}" ]]; then
      rm -f "${link_backups[i]}"
    else
      printf 'Backup: %s\n' "${link_backups[i]}"
    fi
  fi
done

printf 'Installed package: %s -> %s\n' \
  "$SOURCE_ROOT" "$INSTALL_ROOT"

printf 'Primary command: %s -> %s\n' \
  "$PRIMARY_TARGET" "$INSTALL_ROOT/fastly-audit"

printf 'Compatibility command: %s -> %s\n' \
  "$LEGACY_TARGET" "$INSTALL_ROOT/ngwaf"

printf 'Updater command: %s -> %s\n' \
  "$UPDATER_TARGET" "$INSTALL_ROOT/ngwaf-update"
printf 'Short command: %s -> %s\n' \
  "$SHORT_TARGET" "$INSTALL_ROOT/fastly-audit"

case ":$PATH:" in
  *":$BIN_DIR:"*)
    ;;
  *)
    printf 'PATH note: add %s to PATH if fastly-audit or ngwaf is not found.\n' \
      "$BIN_DIR"
    ;;
esac

printf 'Required runtime: Bash %s or newer via /usr/bin/env bash\n' \
  "$NGWAF_MIN_BASH_VERSION"

printf '\nNext setup check:\n'
printf '  Load FASTLY_API_TOKEN through your approved credential workflow.\n'
printf '  fa setup --customer-id CUSTOMER_ID\n'
printf '  fa ngwaf workspace-services --service-id EXACT_CDN_SERVICE_ID --json\n'
