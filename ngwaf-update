#!/usr/bin/env bash
set -euo pipefail

_ngwaf_update_source="${BASH_SOURCE[0]}"
while [[ -h "$_ngwaf_update_source" ]]; do
  _ngwaf_update_dir="$(cd -P "$(dirname "$_ngwaf_update_source")" >/dev/null 2>&1 && pwd)"
  _ngwaf_update_source="$(readlink "$_ngwaf_update_source")"
  [[ "$_ngwaf_update_source" == /* ]] ||
    _ngwaf_update_source="$_ngwaf_update_dir/$_ngwaf_update_source"
done
NGWAF_UPDATE_ROOT="$(cd -P "$(dirname "$_ngwaf_update_source")" >/dev/null 2>&1 && pwd)"
unset _ngwaf_update_source _ngwaf_update_dir

[[ -r "$NGWAF_UPDATE_ROOT/lib/runtime.sh" ]] || {
  printf 'ngwaf-update: missing module: %s\n' \
    "$NGWAF_UPDATE_ROOT/lib/runtime.sh" >&2
  exit 1
}
# shellcheck source=lib/runtime.sh
source "$NGWAF_UPDATE_ROOT/lib/runtime.sh"
ngwaf_require_bash_runtime ngwaf-update

BIN_DIR="${FASTLY_AUDIT_BIN_DIR:-$HOME/bin}"
PRIMARY_TARGET="$BIN_DIR/fastly-audit"
LEGACY_TARGET="$BIN_DIR/ngwaf"
UPDATER_TARGET="$BIN_DIR/ngwaf-update"
SHORT_TARGET="$BIN_DIR/fa"
INSTALL_ROOT="${FASTLY_AUDIT_INSTALL_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/fastly-audit}"

candidate="${1:-.}"

# Preserve the legacy workflow: `ngwaf-update ./ngwaf` infers the package root
# from the compatibility entry point. A directory or fastly-audit executable
# may also be supplied directly.
if [[ -d "$candidate" ]]; then
  SOURCE_ROOT="$(cd "$candidate" && pwd -P)"
elif [[ -f "$candidate" ]]; then
  SOURCE_ROOT="$(cd "$(dirname "$candidate")" && pwd -P)"
else
  printf 'ngwaf-update: not found: %s\n' "$candidate" >&2
  exit 1
fi

[[ -f "$SOURCE_ROOT/fastly-audit" \
  && -f "$SOURCE_ROOT/ngwaf" \
  && -f "$SOURCE_ROOT/lib/runtime.sh" \
  && -d "$SOURCE_ROOT/lib" \
  && -d "$SOURCE_ROOT/customer" ]] || {
  printf 'ngwaf-update: %s is not a modular fastly-audit package\n' \
    "$SOURCE_ROOT" >&2
  exit 1
}

update_fail_preflight() {
  printf 'ngwaf-update: %s\n' "$1" >&2
  printf 'ngwaf-update: installation failed before changes were applied\n' >&2
  exit 1
}

for dependency in find sort install cp mv ln rm mkdir mktemp date dirname readlink cmp; do
  command -v "$dependency" >/dev/null 2>&1 ||
    update_fail_preflight "missing local dependency: $dependency; install it and retry"
done

# Check the nearest existing parent without creating directories during preflight.
update_check_destination() {
  local path="$1" parent
  if [[ -L "$path" || ( -e "$path" && ! -d "$path" ) ]]; then
    update_fail_preflight "destination is not a usable directory: $path; choose another location or resolve the existing path"
  fi
  parent="$path"
  while [[ ! -e "$parent" && ! -L "$parent" ]]; do
    parent="$(dirname "$parent")"
  done
  [[ -d "$parent" && -w "$parent" && -x "$parent" ]] ||
    update_fail_preflight "cannot create or write destination under $parent; choose a writable location"
}

update_check_destination "$INSTALL_ROOT"
update_check_destination "$BIN_DIR"
if [[ -d "$INSTALL_ROOT" ]]; then
  [[ -x "$INSTALL_ROOT/fastly-audit" && -x "$INSTALL_ROOT/ngwaf" \
    && -f "$INSTALL_ROOT/lib/core.sh" && -d "$INSTALL_ROOT/customer" ]] &&
    grep -Fq 'PROGRAM_NAME="${FASTLY_AUDIT_INVOKED_AS:-fastly-audit}"' "$INSTALL_ROOT/fastly-audit" ||
    update_fail_preflight "existing installation at $INSTALL_ROOT is not a recognized fastly-audit package; move it aside manually before retrying"
fi

# Earlier supported releases linked the commands to this package; the oldest
# supported updater was also installed as a regular file by the documented flow.
update_owned_link() {
  local target="$1" expected="$2" legacy_root
  [[ -L "$target" ]] || return 1
  [[ "$target" -ef "$expected" ]] && return 0
  if [[ "$target" == "$LEGACY_TARGET" ]]; then
    legacy_root="${XDG_DATA_HOME:-$HOME/.local/share}/ngwaf"
    [[ "$(readlink "$target")" == "$legacy_root/ngwaf" \
      && -f "$legacy_root/ngwaf" && -f "$legacy_root/lib/core.sh" ]] && return 0
  fi
  return 1
}

update_owned_regular_updater() {
  local target="$1" digest
  [[ -f "$target" && -x "$target" && ! -L "$target" ]] || return 1
  cmp -s "$target" "$SOURCE_ROOT/ngwaf-update" && return 0
  if command -v sha256sum >/dev/null 2>&1; then
    digest="$(sha256sum "$target")"
  elif command -v shasum >/dev/null 2>&1; then
    digest="$(shasum -a 256 "$target")"
  else
    return 1
  fi
  # Released updater file hashes: v23.2-v24.1, then v24.2-v24.2.2.
  case "${digest%% *}" in
    ff7a54dabea9cc84a0a0234718012ec84d674bb7704ea71e10e8761d42dca95c|\
    252f70dab57c1ea565304377a8c7e50541baf216e6df6c59553ae9da95854e7e) return 0 ;;
  esac
  return 1
}

declare -a link_targets=("$PRIMARY_TARGET" "$LEGACY_TARGET" "$UPDATER_TARGET" "$SHORT_TARGET")
declare -a link_sources=("$INSTALL_ROOT/fastly-audit" "$INSTALL_ROOT/ngwaf" "$INSTALL_ROOT/ngwaf-update" "$INSTALL_ROOT/fastly-audit")
for (( i=0; i<${#link_targets[@]}; i++ )); do
  target="${link_targets[i]}"
  [[ -e "$target" || -L "$target" ]] || continue
  if update_owned_link "$target" "${link_sources[i]}"; then
    continue
  fi
  if [[ "$target" == "$UPDATER_TARGET" ]] && update_owned_regular_updater "$target"; then
    continue
  fi
  update_fail_preflight "$target already exists and is not this installation; choose another bin directory or resolve the conflict"
done

# Validate every Bash source before touching the current installation.
while IFS= read -r file; do
  "$BASH" -n "$file"
done < <(
  find "$SOURCE_ROOT" -type f \
    \( \
      -name 'fastly-audit' \
      -o -name 'ngwaf' \
      -o -name 'ngwaf-update' \
      -o -name '*.sh' \
    \) \
    -print |
  sort
)

stage="$(mktemp -d "${TMPDIR:-/tmp}/fastly-audit-install.XXXXXX")"

cleanup_stage() {
  local status=$?
  rm -rf "$stage"
  if (( status != 0 )); then
    printf 'ngwaf-update: installation failed before changes were applied\n' >&2
  fi
}

trap cleanup_stage EXIT

mkdir -p "$stage/lib" "$stage/customer"

install -m 755 "$SOURCE_ROOT/fastly-audit" "$stage/fastly-audit"

install -m 755 "$SOURCE_ROOT/ngwaf" "$stage/ngwaf"

install -m 755 "$SOURCE_ROOT/ngwaf-update" "$stage/ngwaf-update"

cp -R "$SOURCE_ROOT/lib/." "$stage/lib/"
cp -R "$SOURCE_ROOT/customer/." "$stage/customer/"

mkdir -p "$(dirname "$INSTALL_ROOT")" "$BIN_DIR"
declare -a link_backups=('' '' '' '')
declare -a link_created=(false false false false)
declare -a prior_link_destinations=('' '' '' '')
package_backup=''
package_installed=false
transaction_active=false
had_existing_install=false

finish_install() {
  local status=$?
  local i recovery_ok=true prior_backup=false target
  trap - EXIT INT TERM
  if [[ "$transaction_active" == true ]]; then
    for (( i=${#link_targets[@]}-1; i>=0; i-- )); do
      target="${link_targets[i]}"
      if [[ "${link_created[i]}" == true ]]; then
        if [[ -L "$target" && "$(readlink "$target")" == "${link_sources[i]}" ]]; then
          rm -f "$target" || recovery_ok=false
        else
          recovery_ok=false
        fi
      fi
      if [[ -n "${link_backups[i]}" ]]; then
        if [[ ! -e "$target" && ! -L "$target" ]]; then
          mv "${link_backups[i]}" "$target" || recovery_ok=false
          if [[ -n "${prior_link_destinations[i]}" ]]; then
            [[ -L "$target" && "$(readlink "$target")" == "${prior_link_destinations[i]}" ]] || recovery_ok=false
          else
            [[ -f "$target" && -x "$target" ]] || recovery_ok=false
          fi
        else
          recovery_ok=false
        fi
      fi
    done
    if [[ "$package_installed" == true ]]; then
      if [[ -d "$INSTALL_ROOT" && -x "$INSTALL_ROOT/fastly-audit" ]]; then
        rm -rf "$INSTALL_ROOT" || recovery_ok=false
      else
        recovery_ok=false
      fi
    fi
    if [[ -n "$package_backup" && -d "$package_backup" ]]; then
      prior_backup=true
      if [[ ! -e "$INSTALL_ROOT" && ! -L "$INSTALL_ROOT" ]]; then
        mv "$package_backup" "$INSTALL_ROOT" || recovery_ok=false
      else
        recovery_ok=false
      fi
    fi
    if [[ "$recovery_ok" == true && "$prior_backup" == true \
      && -x "$INSTALL_ROOT/fastly-audit" && -x "$INSTALL_ROOT/ngwaf" ]]; then
      printf 'ngwaf-update: installation failed; previous installation restored and verified\n' >&2
    elif [[ "$recovery_ok" == true && "$package_installed" == true && "$prior_backup" == false ]]; then
      printf 'ngwaf-update: installation failed; incomplete installation removed; rollback unnecessary\n' >&2
    elif [[ "$recovery_ok" == true && "$package_installed" == false && "$prior_backup" == false ]]; then
      printf 'ngwaf-update: installation failed before changes were applied\n' >&2
    else
      printf 'ngwaf-update: installation failed; automatic rollback could not be verified; manual recovery required\n' >&2
      [[ -d "$package_backup" ]] && printf 'ngwaf-update: backup retained: %s\n' "$package_backup" >&2
      for (( i=0; i<${#link_targets[@]}; i++ )); do
        [[ -e "${link_backups[i]}" || -L "${link_backups[i]}" ]] &&
          printf 'ngwaf-update: command backup retained: %s\n' "${link_backups[i]}" >&2
      done
    fi
  fi
  rm -rf "$stage"
  exit "$status"
}
trap finish_install EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

transaction_active=true
if [[ -d "$INSTALL_ROOT" ]]; then
  had_existing_install=true
  package_backup="${INSTALL_ROOT}.backup-$(date +%Y%m%d-%H%M%S)-$$"
  mv "$INSTALL_ROOT" "$package_backup"
  printf 'Backup: %s\n' "$package_backup"
fi

mv "$stage" "$INSTALL_ROOT"
package_installed=true
for (( i=0; i<${#link_targets[@]}; i++ )); do
  if [[ -e "${link_targets[i]}" || -L "${link_targets[i]}" ]]; then
    prior_link="${link_targets[i]}.backup-$(date +%Y%m%d-%H%M%S)-$$"
    if [[ -L "${link_targets[i]}" ]]; then
      prior_link_destinations[i]="$(readlink "${link_targets[i]}")"
    fi
    mv "${link_targets[i]}" "$prior_link"
    link_backups[i]="$prior_link"
  fi
  ln -s "${link_sources[i]}" "${link_targets[i]}"
  link_created[i]=true
done

"$PRIMARY_TARGET" version
"$LEGACY_TARGET" version
"$SHORT_TARGET" version
transaction_active=false
trap - INT TERM
for (( i=0; i<${#link_targets[@]}; i++ )); do
  if [[ -n "${link_backups[i]}" ]]; then
    if [[ -L "${link_backups[i]}" ]]; then
      rm -f "${link_backups[i]}"
    else
      printf 'Backup: %s\n' "${link_backups[i]}"
    fi
  fi
done

printf 'Installed package: %s -> %s\n' \
  "$SOURCE_ROOT" "$INSTALL_ROOT"
if [[ "$had_existing_install" == true ]]; then
  printf 'ngwaf-update: upgrade succeeded\n'
else
  printf 'ngwaf-update: installation succeeded\n'
fi

printf 'Primary command: %s -> %s\n' \
  "$PRIMARY_TARGET" "$INSTALL_ROOT/fastly-audit"

printf 'Compatibility command: %s -> %s\n' \
  "$LEGACY_TARGET" "$INSTALL_ROOT/ngwaf"

printf 'Updater command: %s -> %s\n' \
  "$UPDATER_TARGET" "$INSTALL_ROOT/ngwaf-update"
printf 'Short command: %s -> %s\n' \
  "$SHORT_TARGET" "$INSTALL_ROOT/fastly-audit"

case ":$PATH:" in
  *":$BIN_DIR:"*)
    ;;
  *)
    printf 'PATH note: add %s to PATH if fastly-audit or ngwaf is not found.\n' \
      "$BIN_DIR"
    ;;
esac

printf 'Required runtime: Bash %s or newer via /usr/bin/env bash\n' \
  "$NGWAF_MIN_BASH_VERSION"

printf '\nNext setup check:\n'
printf '  Load FASTLY_API_TOKEN through your approved credential workflow.\n'
printf '  fa setup --customer-id CUSTOMER_ID\n'
printf '  fa ngwaf workspace-services --service-id EXACT_CDN_SERVICE_ID --json\n'
