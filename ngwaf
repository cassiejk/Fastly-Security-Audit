cmd_metrics() {
  [[ $# -ge 1 ]] ||
    die 'usage: ngwaf metrics <metric1,metric2,...> [days] [--json]'

  local cid metrics days format body summary
  cid="$(current_cid)"
  metrics="$(tr -d '[:space:]' <<<"$1")"
  days="${2:-30}"
  format="${3:-}"

  if [[ "$days" == "--json" ]]; then
    format="--json"
    days=30
  fi

  [[ -n "$metrics" ]] || die 'at least one metric is required'
  validate_timeseries_days "$days"
  [[ -z "$format" || "$format" == "--json" ]] ||
    die 'usage: ngwaf metrics <metric1,metric2,...> [days] [--json]'

  make_timeseries_window "$days"

  body="$(
    get "/ngwaf/v1/timeseries" \
      --data-urlencode "customer_id=$cid" \
      --data-urlencode "from=$TS_FROM" \
      --data-urlencode "to=$TS_TO" \
      --data-urlencode "metrics=$metrics" \
      --data-urlencode "dimensions=workspaces,time" \
      --data-urlencode "granularity=86400"
  )"

  summary="$(
    jq --arg metrics "$metrics" '
      ($metrics | split(",")) as $metrics
      | [
          .data[]
          | {
              workspace: .dimensions.workspace,
              values: (.values[0] // {})
            }
        ]
      | group_by(.workspace)
      | map(
          . as $rows
          | {workspace: $rows[0].workspace}
            + reduce $metrics[] as $metric (
                {};
                .[$metric] = (
                  [$rows[] | (.values[$metric] // 0)] | add
                )
              )
        )
      | sort_by(.workspace)
    ' <<<"$body"
  )"

  if [[ "$format" == "--json" ]]; then
    jq . <<<"$summary"
    return
  fi

  printf 'Account-level NGWAF metric summary — %s days\n' "$days"
  printf '%s → %s UTC (complete days)\n\n' "$TS_FROM" "$TS_TO"

  jq -r --arg metrics "$metrics" '
    ($metrics | split(",")) as $metrics
    | (["WORKSPACE"] + $metrics),
      (
        .[] as $row
        | [$row.workspace]
          + [$metrics[] as $metric | (($row[$metric] // 0) | tostring)]
      )
    | @tsv
  ' <<<"$summary" | human_table
}

historical_bot_summary_json() {
  local service_id="$1"
  local cid service service_cid service_name body

  cid="$(current_cid)"

  service="$(get "/service/$service_id")"
  service_cid="$(jq -r '.customer_id // ""' <<<"$service")"
  service_name="$(jq -r '.name // ""' <<<"$service")"

  [[ "$service_cid" == "$cid" ]] ||
    die "service $service_id belongs to customer $service_cid, not selected customer $cid"

  body="$(
    get "/stats/service/$service_id" \
      --data-urlencode "from=$HIST_FROM" \
      --data-urlencode "to=$HIST_TO" \
      --data-urlencode "by=day"
  )"

  jq -n \
    --arg service_id "$service_id" \
    --arg service_name "$service_name" \
    --arg customer_id "$cid" \
    --arg from "$HIST_FROM" \
    --arg to "$HIST_TO" \
    --argjson rows "$(jq '.data // []' <<<"$body")" \
    '
    def n:
      if . == null then 0
      elif type == "number" then .
      else (tonumber? // 0)
      end;

    ($rows | map(.edge_requests | n) | add // 0) as $edge_requests
    | ($rows | map(.bot_edge_requests_analyzed_count | n) | add // 0) as $analyzed
    | ($rows | map(.bot_edge_requests_detected_count | n) | add // 0) as $detected
    | ($rows | map(.bot_edge_requests_verified_count | n) | add // 0) as $verified
    | ($rows | map(.bot_edge_requests_headless_count | n) | add // 0) as $headless
    | ($rows | map(.bot_edge_requests_ai_crawler_count | n) | add // 0) as $ai
    | ($rows | map(.bot_edge_requests_search_engine_crawler_count | n) | add // 0) as $search
    | {
        customer_id: $customer_id,
        service_id: $service_id,
        service_name: $service_name,
        from: $from,
        to: $to,
        daily_rows: ($rows | length),
        edge_requests: $edge_requests,
        analyzed: $analyzed,
        detected: $detected,
        bot_percentage: (
          if $analyzed > 0
          then (($detected / $analyzed) * 100)
          else null
          end
        ),
        verified: $verified,
        headless: $headless,
        ai_crawler: $ai,
        search_engine_crawler: $search
      }
    '
}

