#!/usr/bin/env bash
set -euo pipefail

_ngwaf_source="${BASH_SOURCE[0]}"
while [[ -h "$_ngwaf_source" ]]; do
  _ngwaf_dir="$(cd -P "$(dirname "$_ngwaf_source")" >/dev/null 2>&1 && pwd)"
  _ngwaf_source="$(readlink "$_ngwaf_source")"
  [[ "$_ngwaf_source" == /* ]] ||
    _ngwaf_source="$_ngwaf_dir/$_ngwaf_source"
done
_ngwaf_root="$(cd -P "$(dirname "$_ngwaf_source")" >/dev/null 2>&1 && pwd)"

[[ -r "$_ngwaf_root/lib/runtime.sh" ]] || {
  printf 'ngwaf: missing module: %s\n' \
    "$_ngwaf_root/lib/runtime.sh" >&2
  exit 1
}
# shellcheck source=lib/runtime.sh
source "$_ngwaf_root/lib/runtime.sh"
ngwaf_require_bash_runtime ngwaf

[[ -x "$_ngwaf_root/fastly-audit" ]] || {
  printf 'ngwaf: missing executable: %s\n' \
    "$_ngwaf_root/fastly-audit" >&2
  exit 1
}

FASTLY_AUDIT_INVOKED_AS=ngwaf \
  exec "$_ngwaf_root/fastly-audit" "$@"
