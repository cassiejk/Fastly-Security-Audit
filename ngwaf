#!/usr/bin/env bash
set -euo pipefail

VERSION="14.0"
API_BASE="https://api.fastly.com"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/fastly-ngwaf"
CID_FILE="$CONFIG_DIR/customer_id"
CORE_METRICS="requests_total,requests_attack,requests_total_blocked"
BOT_HIST_FIELDS="edge_requests,bot_edge_requests_analyzed_count,bot_edge_requests_detected_count,bot_edge_requests_verified_count,bot_edge_requests_headless_count,bot_edge_requests_ai_crawler_count,bot_edge_requests_ai_fetcher_count,bot_edge_requests_search_engine_crawler_count,bot_edge_requests_accessibility_count,bot_edge_requests_content_fetcher_count,bot_edge_requests_monitoring_count,bot_edge_requests_online_marketing_count,bot_edge_requests_page_preview_count,bot_edge_requests_platform_integrations_count,bot_edge_requests_research_count,bot_edge_requests_search_engine_optimization_count,bot_edge_requests_security_tools_count"

die() {
  printf 'ngwaf: %s\n' "$*" >&2
  exit 1
}

require() {
  command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"
}

require curl
require jq

case "${1:-help}" in
  help|-h|--help|version)
    ;;
  *)
    [[ -n "${FASTLY_API_TOKEN:-}" ]] ||
      die 'FASTLY_API_TOKEN is not set'
    ;;
esac

urlencode() {
  jq -rn --arg v "$1" '$v | @uri'
}

get() {
  local path="$1"
  shift

  local tmp code
  tmp="$(mktemp)"

  code="$(
    curl -sS -G \
      -o "$tmp" \
      -w '%{http_code}' \
      -H "Fastly-Key: $FASTLY_API_TOKEN" \
      -H "Accept: application/json" \
      "$@" \
      "$API_BASE$path"
  )" || {
    rm -f "$tmp"
    die "curl request failed"
  }

  case "$code" in
    2*)
      cat "$tmp"
      ;;
    *)
      printf 'Fastly API returned HTTP %s\n' "$code" >&2
      jq . "$tmp" 2>/dev/null >&2 || cat "$tmp" >&2
      rm -f "$tmp"
      exit 1
      ;;
  esac

  rm -f "$tmp"
}

current_cid() {
  if [[ -n "${FASTLY_CUSTOMER_ID:-}" ]]; then
    printf '%s\n' "$FASTLY_CUSTOMER_ID"
  elif [[ -s "$CID_FILE" ]]; then
    cat "$CID_FILE"
  else
    die 'no customer selected; run: ngwaf use <customer_id>'
  fi
}

workspace_path() {
  printf '/ngwaf/v1/workspaces/%s' "$(urlencode "$1")"
}

validate_timeseries_days() {
  local days="$1"
  [[ "$days" =~ ^[0-9]+$ ]] || die 'days must be an integer'
  (( days >= 1 && days <= 30 )) ||
    die 'timeseries days must be between 1 and 30'
}

validate_request_days() {
  local days="$1"
  [[ "$days" =~ ^[0-9]+$ ]] || die 'days must be an integer'
  (( days >= 1 && days <= 7 )) ||
    die 'request-search days must be between 1 and 7'
}

# Use complete UTC days for timeseries summaries so repeated reports are comparable.
TS_FROM=""
TS_TO=""
make_timeseries_window() {
  local days="$1"
  validate_timeseries_days "$days"

  TS_TO="$(date -u '+%Y-%m-%dT00:00:00Z')"

  if date -u -v-"${days}"d '+%Y-%m-%dT00:00:00Z' >/dev/null 2>&1; then
    TS_FROM="$(date -u -v-"${days}"d '+%Y-%m-%dT00:00:00Z')"
  else
    TS_FROM="$(date -u -d "$days days ago" '+%Y-%m-%dT00:00:00Z')"
  fi
}

validate_historical_days() {
  local days="$1"
  [[ "$days" =~ ^[0-9]+$ ]] || die 'bot historical-stats days must be an integer'
  (( days >= 1 && days <= 30 )) ||
    die 'bot historical-stats days must be between 1 and 30 for this workflow'
}

HIST_FROM=""
HIST_TO=""

make_historical_window_days() {
  local days="$1"
  validate_historical_days "$days"

  HIST_TO="$(date -u '+%Y-%m-%dT00:00:00Z')"

  if date -u -v-"${days}"d '+%Y-%m-%dT00:00:00Z' >/dev/null 2>&1; then
    HIST_FROM="$(date -u -v-"${days}"d '+%Y-%m-%dT00:00:00Z')"
  else
    HIST_FROM="$(date -u -d "$days days ago" '+%Y-%m-%dT00:00:00Z')"
  fi
}

set_historical_window_dates() {
  local from_date="$1"
  local to_date="$2"

  [[ "$from_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] ||
    die 'from date must be YYYY-MM-DD'
  [[ "$to_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] ||
    die 'to date must be YYYY-MM-DD'

  HIST_FROM="${from_date}T00:00:00Z"
  HIST_TO="${to_date}T00:00:00Z"
}

validate_monthly_historical_window() {
  local from_date="$1"
  local to_date="$2"
  local from_epoch to_epoch span_days

  if date -u -j -f "%Y-%m-%d" "$from_date" "+%s" >/dev/null 2>&1; then
    from_epoch="$(date -u -j -f "%Y-%m-%d" "$from_date" "+%s")"
    to_epoch="$(date -u -j -f "%Y-%m-%d" "$to_date" "+%s")"
  else
    from_epoch="$(date -u -d "$from_date" "+%s")"
    to_epoch="$(date -u -d "$to_date" "+%s")"
  fi

  (( to_epoch > from_epoch )) || die 'TO date must be after FROM date'
  span_days=$(( (to_epoch - from_epoch) / 86400 ))

  # Allow a full calendar month such as Aug 1 -> Sep 1 (31 days),
  # but intentionally reject quarter-length windows for this workflow.
  (( span_days <= 31 )) ||
    die 'exact Bot Management date range must be 31 days or less for this workflow'
}

human_table() {
  if command -v column >/dev/null 2>&1; then
    column -t -s $'\t'
  else
    cat
  fi
}

cmd_version() {
  printf 'ngwaf %s\n' "$VERSION"
}

cmd_whoami() {
  get "/tokens/self" |
    jq '{name, scope, expires_at}'
}

cmd_use() {
  [[ $# -eq 1 ]] || die 'usage: ngwaf use <customer_id>'

  local cid="$1"
  local body

  body="$(get "/customer/$cid")"

  mkdir -p "$CONFIG_DIR"
  printf '%s\n' "$cid" > "$CID_FILE"

  printf 'Selected customer: %s (%s)\n' \
    "$(jq -r '.name' <<<"$body")" \
    "$cid"
}

cmd_customer() {
  local cid
  cid="$(current_cid)"

  get "/customer/$cid" |
    jq '{id, name}'
}

cmd_workspaces() {
  local cid body total returned
  cid="$(current_cid)"

  body="$(
    get "/ngwaf/v1/workspaces" \
      --data-urlencode "customer_id=$cid" \
      --data-urlencode "limit=100"
  )"

  total="$(jq -r '.meta.total // (.data | length)' <<<"$body")"
  returned="$(jq -r '.data | length' <<<"$body")"

  printf 'Total NGWAF workspaces: %s\n\n' "$total"

  jq -r '
    .data
    | sort_by(.name)
    | .[]
    | .name
  ' <<<"$body"

  if (( total > returned )); then
    printf '\nWARNING: API returned %s of %s workspaces.\n' \
      "$returned" "$total" >&2
  fi
}

cmd_workspace() {
  [[ $# -eq 1 ]] || die 'usage: ngwaf workspace <workspace>'

  local cid w
  cid="$(current_cid)"
  w="$1"

  get "$(workspace_path "$w")" \
    --data-urlencode "customer_id=$cid" |
    jq '{
      name,
      mode,
      immediate_blocking: .attack_signal_thresholds.immediate,
      default_blocking_response_code
    }'
}

cmd_rules() {
  [[ $# -ge 1 ]] || die 'usage: ngwaf rules <workspace> [--list|--json]'

  local cid w mode body total returned
  cid="$(current_cid)"
  w="$1"
  mode="${2:-}"

  body="$(
    get "$(workspace_path "$w")/rules" \
      --data-urlencode "customer_id=$cid" \
      --data-urlencode "limit=100"
  )"

  if [[ "$mode" == "--json" ]]; then
    jq . <<<"$body"
    return
  fi

  jq --arg w "$w" '{
    workspace: $w,
    total_rules_returned: (.data | length),
    enabled_rules_returned: ([.data[] | select(.enabled == true)] | length),
    disabled_rules_returned: ([.data[] | select(.enabled == false)] | length),
    enabled_allow_rules_returned: (
      [
        .data[]
        | select(
            .enabled == true
            and ((.actions | tostring) | test("allow"; "i"))
          )
      ] | length
    )
  }' <<<"$body"

  total="$(jq -r '.meta.total // (.data | length)' <<<"$body")"
  returned="$(jq -r '.data | length' <<<"$body")"
  if (( total > returned )); then
    printf 'WARNING: API returned %s of %s rules; counts above are partial.\n' \
      "$returned" "$total" >&2
  fi

  if [[ "$mode" == "--list" ]]; then
    printf '\n'
    jq -r '
      ["ENABLED", "ACTIONS", "DESCRIPTION"],
      (
        .data[]
        | [
            (.enabled | tostring),
            ([.actions[]?.type] | join(",")),
            (.description // "")
          ]
      )
      | @tsv
    ' <<<"$body" | human_table
  fi
}

cmd_thresholds() {
  [[ $# -ge 1 ]] || die 'usage: ngwaf thresholds <workspace> [--json]'

  local cid w mode body
  cid="$(current_cid)"
  w="$1"
  mode="${2:-}"

  body="$(
    get "$(workspace_path "$w")/thresholds" \
      --data-urlencode "customer_id=$cid"
  )"

  if [[ "$mode" == "--json" ]]; then
    jq . <<<"$body"
    return
  fi

  jq --arg w "$w" '{
    workspace: $w,
    total_thresholds: (.data | length),
    enabled_thresholds: ([.data[] | select(.enabled == true)] | length),
    disabled_thresholds: ([.data[] | select(.enabled == false)] | length)
  }' <<<"$body"
}

cmd_posture() {
  [[ $# -eq 1 ]] || die 'usage: ngwaf posture <workspace>'

  local cid w ws rules thresholds
  local mode immediate response_code
  local total_rules enabled_rules allow_rules
  local total_thresholds enabled_thresholds

  cid="$(current_cid)"
  w="$1"

  ws="$(
    get "$(workspace_path "$w")" \
      --data-urlencode "customer_id=$cid"
  )"

  rules="$(
    get "$(workspace_path "$w")/rules" \
      --data-urlencode "customer_id=$cid" \
      --data-urlencode "limit=100"
  )"

  thresholds="$(
    get "$(workspace_path "$w")/thresholds" \
      --data-urlencode "customer_id=$cid"
  )"

  mode="$(jq -r '.mode // "unknown"' <<<"$ws")"
  immediate="$(jq -r '.attack_signal_thresholds.immediate // false' <<<"$ws")"
  response_code="$(jq -r '.default_blocking_response_code // null' <<<"$ws")"

  total_rules="$(jq '.data | length' <<<"$rules")"
  enabled_rules="$(jq '[.data[] | select(.enabled == true)] | length' <<<"$rules")"
  allow_rules="$(
    jq '
      [
        .data[]
        | select(
            .enabled == true
            and ((.actions | tostring) | test("allow"; "i"))
          )
      ] | length
    ' <<<"$rules"
  )"

  total_thresholds="$(jq '.data | length' <<<"$thresholds")"
  enabled_thresholds="$(jq '[.data[] | select(.enabled == true)] | length' <<<"$thresholds")"

  jq -n \
    --arg workspace "$w" \
    --arg mode "$mode" \
    --argjson immediate "$immediate" \
    --argjson response_code "$response_code" \
    --argjson total_rules "$total_rules" \
    --argjson enabled_rules "$enabled_rules" \
    --argjson allow_rules "$allow_rules" \
    --argjson total_thresholds "$total_thresholds" \
    --argjson enabled_thresholds "$enabled_thresholds" \
    '{
      workspace: $workspace,
      enforcement: {
        mode: $mode,
        immediate_blocking: $immediate,
        default_blocking_response_code: $response_code
      },
      rules: {
        total_returned: $total_rules,
        enabled_returned: $enabled_rules,
        enabled_allow_rules_returned: $allow_rules
      },
      thresholds: {
        total: $total_thresholds,
        enabled: $enabled_thresholds
      }
    }'
}

cmd_bot_rules() {
  [[ $# -eq 1 ]] || die 'usage: ngwaf bot-rules <workspace>'

  local cid w body
  cid="$(current_cid)"
  w="$1"

  body="$(
    get "$(workspace_path "$w")/rules" \
      --data-urlencode "customer_id=$cid" \
      --data-urlencode "limit=100"
  )"

  jq -r '
    ["ENABLED", "ACTIONS", "DESCRIPTION"],
    (
      .data[]
      | select(
          ([.conditions[]? | tostring] | join(" "))
          | test(
              "VERIFIED-BOT|SUSPECTED-BOT|SUSPECTED-BAD-BOT|DATACENTER";
              "i"
            )
        )
      | [
          (.enabled | tostring),
          ([.actions[]?.type] | join(",")),
          (.description // "")
        ]
    )
    | @tsv
  ' <<<"$body" | human_table
}

cmd_overview() {
  local days="${1:-30}"
  local format="${2:-}"
  local cid customer body summary

  [[ "$days" != "--json" ]] || {
    format="--json"
    days=30
  }

  validate_timeseries_days "$days"
  [[ -z "$format" || "$format" == "--json" ]] ||
    die 'usage: ngwaf overview [days] [--json]'

  cid="$(current_cid)"
  make_timeseries_window "$days"

  customer="$(get "/customer/$cid" | jq -r '.name')"

  body="$(
    get "/ngwaf/v1/timeseries" \
      --data-urlencode "customer_id=$cid" \
      --data-urlencode "from=$TS_FROM" \
      --data-urlencode "to=$TS_TO" \
      --data-urlencode "metrics=$CORE_METRICS" \
      --data-urlencode "dimensions=workspaces,time" \
      --data-urlencode "granularity=86400"
  )"

  summary="$(
    jq '
      [
        .data[]
        | {
            workspace: .dimensions.workspace,
            values: (.values[0] // {})
          }
      ]
      | group_by(.workspace)
      | map({
          workspace: .[0].workspace,
          requests_total: (map(.values.requests_total // 0) | add),
          requests_attack: (map(.values.requests_attack // 0) | add),
          requests_total_blocked: (map(.values.requests_total_blocked // 0) | add)
        })
      | sort_by(-.requests_total)
    ' <<<"$body"
  )"

  if [[ "$format" == "--json" ]]; then
    jq -n \
      --arg customer "$customer" \
      --arg customer_id "$cid" \
      --arg from "$TS_FROM" \
      --arg to "$TS_TO" \
      --argjson days "$days" \
      --argjson workspaces "$summary" \
      '{
        customer: $customer,
        customer_id: $customer_id,
        days: $days,
        from: $from,
        to: $to,
        workspaces: $workspaces
      }'
    return
  fi

  printf '%s — NGWAF %s-day overview\n' "$customer" "$days"
  printf '%s → %s UTC (complete days)\n\n' "$TS_FROM" "$TS_TO"

  jq -r '
    def human:
      if . >= 1000000000 then (((. / 1000000000) * 100 | round) / 100 | tostring) + "B"
      elif . >= 1000000 then (((. / 1000000) * 100 | round) / 100 | tostring) + "M"
      elif . >= 1000 then (((. / 1000) * 10 | round) / 10 | tostring) + "K"
      else tostring
      end;

    ["WORKSPACE", "REQUESTS", "ATTACK-TAGGED", "BLOCKED"],
    (
      .[]
      | [
          .workspace,
          (.requests_total | human),
          (.requests_attack | human),
          (.requests_total_blocked | human)
        ]
    )
    | @tsv
  ' <<<"$summary" | human_table

  printf '\nNote: attack-tagged and blocked are independent metrics; do not divide one by the other as a block-rate calculation.\n'
}

cmd_timeseries() {
  [[ $# -ge 1 ]] || die 'usage: ngwaf timeseries <workspace> [days] [--json]'

  local cid w days format body
  cid="$(current_cid)"
  w="$1"
  days="${2:-30}"
  format="${3:-}"

  if [[ "$days" == "--json" ]]; then
    format="--json"
    days=30
  fi

  validate_timeseries_days "$days"
  [[ -z "$format" || "$format" == "--json" ]] ||
    die 'usage: ngwaf timeseries <workspace> [days] [--json]'

  make_timeseries_window "$days"

  body="$(
    get "$(workspace_path "$w")/timeseries" \
      --data-urlencode "customer_id=$cid" \
      --data-urlencode "from=$TS_FROM" \
      --data-urlencode "to=$TS_TO" \
      --data-urlencode "metrics=$CORE_METRICS" \
      --data-urlencode "granularity=86400"
  )"

  if [[ "$format" == "--json" ]]; then
    jq . <<<"$body"
    return
  fi

  printf '%s — %s-day NGWAF timeseries\n' "$w" "$days"
  printf '%s → %s UTC (complete days)\n\n' "$TS_FROM" "$TS_TO"

  jq -r '
    ["DATE", "REQUESTS", "ATTACK-TAGGED", "BLOCKED"],
    (
      .data
      | sort_by(.dimensions.time // .timestamp)
      | .[]
      | [
          ((.dimensions.time // .timestamp) | split("T")[0]),
          ((.values[0].requests_total // 0) | tostring),
          ((.values[0].requests_attack // 0) | tostring),
          ((.values[0].requests_total_blocked // 0) | tostring)
        ]
    )
    | @tsv
  ' <<<"$body" | human_table
}

cmd_metrics() {
  [[ $# -ge 1 ]] ||
    die 'usage: ngwaf metrics <metric1,metric2,...> [days] [--json]'

  local cid metrics days format body summary
  cid="$(current_cid)"
  metrics="$(tr -d '[:space:]' <<<"$1")"
  days="${2:-30}"
  format="${3:-}"

  if [[ "$days" == "--json" ]]; then
    format="--json"
    days=30
  fi

  [[ -n "$metrics" ]] || die 'at least one metric is required'
  validate_timeseries_days "$days"
  [[ -z "$format" || "$format" == "--json" ]] ||
    die 'usage: ngwaf metrics <metric1,metric2,...> [days] [--json]'

  make_timeseries_window "$days"

  body="$(
    get "/ngwaf/v1/timeseries" \
      --data-urlencode "customer_id=$cid" \
      --data-urlencode "from=$TS_FROM" \
      --data-urlencode "to=$TS_TO" \
      --data-urlencode "metrics=$metrics" \
      --data-urlencode "dimensions=workspaces,time" \
      --data-urlencode "granularity=86400"
  )"

  summary="$(
    jq --arg metrics "$metrics" '
      ($metrics | split(",")) as $metrics
      | [
          .data[]
          | {
              workspace: .dimensions.workspace,
              values: (.values[0] // {})
            }
        ]
      | group_by(.workspace)
      | map(
          . as $rows
          | {workspace: $rows[0].workspace}
            + reduce $metrics[] as $metric (
                {};
                .[$metric] = (
                  [$rows[] | (.values[$metric] // 0)] | add
                )
              )
        )
      | sort_by(.workspace)
    ' <<<"$body"
  )"

  if [[ "$format" == "--json" ]]; then
    jq . <<<"$summary"
    return
  fi

  printf 'Account-level NGWAF metric summary — %s days\n' "$days"
  printf '%s → %s UTC (complete days)\n\n' "$TS_FROM" "$TS_TO"

  jq -r --arg metrics "$metrics" '
    ($metrics | split(",")) as $metrics
    | (["WORKSPACE"] + $metrics),
      (
        .[] as $row
        | [$row.workspace]
          + [$metrics[] as $metric | (($row[$metric] // 0) | tostring)]
      )
    | @tsv
  ' <<<"$summary" | human_table
}

historical_bot_summary_json() {
  local service_id="$1"
  local cid service service_cid service_name body

  cid="$(current_cid)"

  service="$(get "/service/$service_id")"
  service_cid="$(jq -r '.customer_id // ""' <<<"$service")"
  service_name="$(jq -r '.name // ""' <<<"$service")"

  [[ "$service_cid" == "$cid" ]] ||
    die "service $service_id belongs to customer $service_cid, not selected customer $cid"

  body="$(
    get "/stats/service/$service_id" \
      --data-urlencode "from=$HIST_FROM" \
      --data-urlencode "to=$HIST_TO" \
      --data-urlencode "by=day"
  )"

  jq -n \
    --arg service_id "$service_id" \
    --arg service_name "$service_name" \
    --arg customer_id "$cid" \
    --arg from "$HIST_FROM" \
    --arg to "$HIST_TO" \
    --argjson rows "$(jq '.data // []' <<<"$body")" \
    '
    def n:
      if . == null then 0
      elif type == "number" then .
      else (tonumber? // 0)
      end;

    ($rows | map(.edge_requests | n) | add // 0) as $edge_requests
    | ($rows | map(.bot_edge_requests_analyzed_count | n) | add // 0) as $analyzed
    | ($rows | map(.bot_edge_requests_detected_count | n) | add // 0) as $detected
    | ($rows | map(.bot_edge_requests_verified_count | n) | add // 0) as $verified
    | ($rows | map(.bot_edge_requests_headless_count | n) | add // 0) as $headless
    | ($rows | map(.bot_edge_requests_ai_crawler_count | n) | add // 0) as $ai
    | ($rows | map(.bot_edge_requests_search_engine_crawler_count | n) | add // 0) as $search
    | {
        customer_id: $customer_id,
        service_id: $service_id,
        service_name: $service_name,
        from: $from,
        to: $to,
        daily_rows: ($rows | length),
        edge_requests: $edge_requests,
        analyzed: $analyzed,
        detected: $detected,
        bot_percentage: (
          if $analyzed > 0
          then (($detected / $analyzed) * 100)
          else null
          end
        ),
        verified: $verified,
        headless: $headless,
        ai_crawler: $ai,
        search_engine_crawler: $search
      }
    '
}

cmd_bot_stats() {
  [[ $# -ge 1 ]] ||
    die 'usage: ngwaf bot-stats <service_id> [days|FROM TO] [--json]'

  local service_id="$1"
  shift

  local format=""
  local summary

  if [[ "${!#:-}" == "--json" ]]; then
    format="--json"
    set -- "${@:1:$(($#-1))}"
  fi

  case "$#" in
    0)
      make_historical_window_days 30
      ;;
    1)
      validate_historical_days "$1"
      make_historical_window_days "$1"
      ;;
    2)
      set_historical_window_dates "$1" "$2"
      validate_monthly_historical_window "$1" "$2"
      ;;
    *)
      die 'usage: ngwaf bot-stats <service_id> [days|FROM TO] [--json]'
      ;;
  esac

  summary="$(historical_bot_summary_json "$service_id")"

  if [[ "$format" == "--json" ]]; then
    jq . <<<"$summary"
    return
  fi

  printf '%s — Historical Bot Management\n' "$(jq -r '.service_name' <<<"$summary")"
  printf '%s → %s UTC (TO is exclusive)\n\n' "$HIST_FROM" "$HIST_TO"

  jq -r '
    def human:
      if . >= 1000000000 then (((. / 1000000000) * 100 | round) / 100 | tostring) + "B"
      elif . >= 1000000 then (((. / 1000000) * 100 | round) / 100 | tostring) + "M"
      elif . >= 1000 then (((. / 1000) * 10 | round) / 10 | tostring) + "K"
      else tostring
      end;

    ["SERVICE", "EDGE REQUESTS", "BOT ANALYZED*", "BOTS DETECTED*", "BOT % OF ANALYZED*", "VERIFIED*", "HEADLESS*", "AI CRAWLER*", "SEARCH CRAWLER*"],
    [
      .service_name,
      (.edge_requests | human),
