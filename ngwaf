  local service_name="$2"
  local cid body

  cid="$(current_cid)"

  body="$(
    get "/stats/service/$service_id" \
      --data-urlencode "from=$HIST_FROM" \
      --data-urlencode "to=$HIST_TO" \
      --data-urlencode "by=day"
