#!/usr/bin/env bash
# Globals below are consumed by modules sourced dynamically later in this file.
# shellcheck disable=SC2034
set -euo pipefail

VERSION="24.2.2"
PROGRAM_NAME="${FASTLY_AUDIT_INVOKED_AS:-fastly-audit}"
USAGE_PROGRAM="$PROGRAM_NAME"
API_BASE="https://api.fastly.com"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/fastly-ngwaf"
CID_FILE="$CONFIG_DIR/customer_id"
CORE_METRICS="requests_total,requests_attack,requests_total_blocked"
BOT_HIST_FIELDS="edge_requests,bot_edge_requests_analyzed_count,bot_edge_requests_detected_count,bot_edge_requests_verified_count,bot_edge_requests_headless_count,bot_edge_requests_ai_crawler_count,bot_edge_requests_ai_fetcher_count,bot_edge_requests_search_engine_crawler_count,bot_edge_requests_accessibility_count,bot_edge_requests_content_fetcher_count,bot_edge_requests_monitoring_count,bot_edge_requests_online_marketing_count,bot_edge_requests_page_preview_count,bot_edge_requests_platform_integrations_count,bot_edge_requests_research_count,bot_edge_requests_search_engine_optimization_count,bot_edge_requests_security_tools_count"
CURL_CONNECT_TIMEOUT="${NGWAF_CURL_CONNECT_TIMEOUT:-5}"
CURL_MAX_TIME="${NGWAF_CURL_MAX_TIME:-60}"
CURL_RETRIES="${NGWAF_CURL_RETRIES:-1}"
CURL_RETRY_MAX_TIME="${NGWAF_CURL_RETRY_MAX_TIME:-90}"
SERVICE_AUDIT_DAYS="${NGWAF_SERVICE_AUDIT_DAYS:-365}"
SERVICE_AUDIT_MAX_PAGES="${NGWAF_SERVICE_AUDIT_MAX_PAGES:-25}"
SERVICE_AUDIT_PAGE_SIZE="${NGWAF_SERVICE_AUDIT_PAGE_SIZE:-100}"
NGWAF_CUSTOMER_CONTEXT_JSON=""

# Resolve the real installation directory even when the command is a symlink.
_ngwaf_source="${BASH_SOURCE[0]}"
while [[ -h "$_ngwaf_source" ]]; do
  _ngwaf_dir="$(cd -P "$(dirname "$_ngwaf_source")" >/dev/null 2>&1 && pwd)"
  _ngwaf_source="$(readlink "$_ngwaf_source")"
  [[ "$_ngwaf_source" == /* ]] || _ngwaf_source="$_ngwaf_dir/$_ngwaf_source"
done
NGWAF_ROOT="$(cd -P "$(dirname "$_ngwaf_source")" >/dev/null 2>&1 && pwd)"
unset _ngwaf_source _ngwaf_dir

[[ -r "$NGWAF_ROOT/lib/runtime.sh" ]] || {
  printf '%s: missing module: %s\n' \
    "$PROGRAM_NAME" "$NGWAF_ROOT/lib/runtime.sh" >&2
  exit 1
}
# shellcheck source=lib/runtime.sh
source "$NGWAF_ROOT/lib/runtime.sh"
ngwaf_require_bash_runtime "$PROGRAM_NAME"

for _ngwaf_module in \
  lib/core.sh \
  lib/doctor.sh \
  lib/setup.sh \
  lib/account.sh \
  lib/services.sh \
  lib/security.sh \
  lib/agent_diagnostic.sh \
  lib/links.sh \
  lib/ddos.sh \
  lib/ngwaf.sh \
  lib/ngwaf_architecture.sh \
  lib/bots.sh \
  lib/metrics.sh \
  lib/platform_metrics_diagnostic.sh \
  lib/request_search.sh \
  lib/rule_audit.sh \
  lib/template_audit.sh \
  lib/attack_analysis.sh \
  lib/snapshots.sh \
  customer/costco.sh \
  lib/help.sh \
  lib/dispatch.sh; do
  [[ -r "$NGWAF_ROOT/$_ngwaf_module" ]] || {
    printf '%s: missing module: %s\n' \
      "$PROGRAM_NAME" "$NGWAF_ROOT/$_ngwaf_module" >&2
    exit 1
  }
  # shellcheck source=/dev/null
  source "$NGWAF_ROOT/$_ngwaf_module"
done
unset _ngwaf_module

dispatch_cli "$@"
